  "problem_spec": {
    "id": "new-product-launch-problem",
    "title": "新品上市流程智能体",
    "description": "把新品上市 know-how 编译成可运行、可评估、可优化的 Agent 工作流。",
    "target_users": ["产品经理", "市场负责人", "渠道负责人", "业务审批人"],
    "business_goal": "减少新品上市跨角色交接的信息损耗，沉淀可复用流程资产。",
    "start_event": "业务方提交新品上市任务。",
    "end_state": "完成 Go / No-Go 决策并留下 trace、eval 和优化建议。",
    "success_metrics": ["字段完整率提升", "返工次数下降", "审批风险可追踪"],
    "constraints": ["MVP 只使用 mock LLM 和 mock tools", "写操作必须审批"],
    "risks": ["市场洞察不足", "定价假设不完整", "写操作绕过审批"],
    "human_roles": ["产品经理", "市场负责人", "渠道负责人", "财务负责人", "业务审批人"],
