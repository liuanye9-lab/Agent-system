        "done_condition": "Go / No-Go 决策完成审批并产出审计记录。",
        "requires_approval": true,
        "input_contract_id": "contract-go-no-go-decision",
        "output_contract_id": "contract-go-no-go-decision",
        "tool_ids": ["mock-go-no-go-decision-tool"]
      }
    ],
    "edges": [
      {"source_node_id": "define-launch-goal", "target_node_id": "collect-market-insights", "condition": null, "edge_type": "default"},
