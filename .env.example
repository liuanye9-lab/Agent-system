# Backend
AGENT_WORKFLOW_DATABASE_URL=sqlite:///./data/prod.sqlite3

# Auth
# Use a long random value in production.
AGENT_WORKFLOW_AUTH_SECRET_KEY=replace-with-a-long-random-secret
AGENT_WORKFLOW_AUTH_TOKEN_TTL_SECONDS=3600
AGENT_WORKFLOW_ALLOW_DEV_ACTOR_HEADERS=false
# Comma-separated browser origins allowed to call the API.
AGENT_WORKFLOW_CORS_ALLOWED_ORIGINS=https://your-dashboard.example.com
# Optional regex for preview deployments, for example Vercel preview URLs.
AGENT_WORKFLOW_CORS_ALLOW_ORIGIN_REGEX=
# Generate password_hash with: python tools/password.py
AGENT_WORKFLOW_AUTH_USERS_JSON={"admin":{"password_hash":"pbkdf2_sha256$310000$replace-salt$replace-digest","actor_id":"admin-1","role":"workflow-admin","display_name":"Admin"}}
AGENT_WORKFLOW_SEED_EXAMPLE_WORKFLOW=false
AGENT_WORKFLOW_RUN_RETENTION_DAYS=90
AGENT_WORKFLOW_EVAL_RETENTION_DAYS=365
AGENT_WORKFLOW_AUDIT_RETENTION_DAYS=365

# Builder Plane LLM
# Leave provider as mock for deterministic local tests. Configure these for production workflow generation.
AGENT_WORKFLOW_LLM_PROVIDER=mock
AGENT_WORKFLOW_LLM_ENDPOINT=
AGENT_WORKFLOW_LLM_MODEL=
AGENT_WORKFLOW_LLM_API_KEY=
AGENT_WORKFLOW_LLM_TIMEOUT_SECONDS=30
AGENT_WORKFLOW_LLM_MAX_TOKENS=4096
AGENT_WORKFLOW_LLM_JSON_RESPONSE_FORMAT=false

# Agnes AI OpenAI-compatible text model example. Keep the API key in your shell or hosting secrets, not Git.
# AGENT_WORKFLOW_LLM_PROVIDER=agnes
# AGENT_WORKFLOW_LLM_ENDPOINT=https://apihub.agnes-ai.com/v1
# AGENT_WORKFLOW_LLM_MODEL=agnes-2.0-flash
# AGENT_WORKFLOW_LLM_API_KEY=
# AGENT_WORKFLOW_LLM_TIMEOUT_SECONDS=90
# AGENT_WORKFLOW_LLM_MAX_TOKENS=4096
# AGENT_WORKFLOW_LLM_JSON_RESPONSE_FORMAT=false
#
# Agnes media model ids for future media adapters:
# AGNES_IMAGE_MODEL=agnes-image-2.0-flash
# AGNES_VIDEO_MODEL=agnes-video-v2.0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Release automation
# Configure these in your shell or hosting provider when deploying from CLI/CI.
GITHUB_TOKEN=
VERCEL_TOKEN=

# Real LLM provider for Agent System Builder
AGENT_WORKFLOW_LLM_PROVIDER=agnes
AGENT_WORKFLOW_LLM_ENDPOINT=https://apihub.agnes-ai.com/v1
AGENT_WORKFLOW_LLM_MODEL=agnes-2.0-flash
# Set this only in local/Vercel secrets, never commit a real key.
AGENT_WORKFLOW_LLM_API_KEY=
AGENT_WORKFLOW_LLM_TIMEOUT_SECONDS=60
